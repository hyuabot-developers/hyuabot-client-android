<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark theme: inherits every item from Theme.HYUabot.Base and changes only the splash background. -->
    <style name="Theme.HYUabot" parent="Theme.HYUabot.Base">
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@android:color/background_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@mipmap/ic_launcher</item>
    </style>
    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.BottomNavigationView</item>
    </style>
    <style name="ThemeOverlay.App.BottomNavigationView" parent="">
        <item name="colorSurfaceContainer">@color/bottom_navigation_background</item>
        <item name="colorOnSurfaceVariant">@color/bottom_navigation_unselected</item>
        <item name="colorOnSecondaryContainer">@color/bottom_navigation_selected</item>
        <item name="colorOnSurface">@color/bottom_navigation_selected</item>
        <item name="colorSecondaryContainer">@color/bottom_navigation_indicator</item>
    </style>
</resources>
